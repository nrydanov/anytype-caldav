# Copy to .env and keep it private (chmod 600 .env).

# The address the server is reached at; Caddy obtains its certificate.
ANYTYPE_CALDAV_DOMAIN=calendar.example.org

# An invite link to the space, made by its owner with editor rights and
# without approval, so the bot joins at once. Anyone holding such a link can
# join, so revoke it once the bot is in; the kit does not use it again. With
# a link that needs approval, the owner approves the bot in Anytype.
ANYTYPE_INVITE_LINK=

# Optional: log in as an existing bot instead of creating a new one, e.g. when
# moving from another host. For a self-hosted network see network/README.md.
# ANYTYPE_ACCOUNT_KEY=

# Optional: the password of the CalDAV login `anytype`. Left out, one is made
# on the first start and printed in the server's log.
# CALDAV_PASSWORD=

# Optional: an account for every person of the space, derived from this
# secret; tasks are assigned by Anytype's Assignee property. Keep it: every
# password changes with it.  openssl rand -hex 32
# ACCOUNTS_SECRET=

# The time zone of the space's dates and of reminders, an IANA name such as
# Europe/Berlin or America/New_York.
ANYTYPE_CALDAV__CALENDAR__TIMEZONE=

# Any other setting of config.example.toml, as ANYTYPE_CALDAV__<SECTION>__<KEY>:
ANYTYPE_CALDAV__CALENDAR__LANGUAGE=en
# The kit serves events and makes the occurrences of recurring series; either
# can be turned off:
# ANYTYPE_CALDAV__CALDAV__EVENTS=false
# ANYTYPE_CALDAV__SERIES__ENABLED=false
