# Copy to .env and keep it private (chmod 600 .env).

# The address the server is reached at; Caddy obtains its certificate.
DOMAIN=calendar.example.org

# An invite link to the space, made by its owner. The bot sends a join
# request; the owner may have to approve it in Anytype.
ANYTYPE_INVITE_LINK=

# Optional: log in as an existing bot instead of creating a new one, e.g. when
# moving from another host. For a self-hosted network see network/README.md.
# ANYTYPE_ACCOUNT_KEY=

# The login of the CalDAV facade (username `anytype`). openssl rand -base64 24
CALDAV_PASSWORD=

# Optional: an account for every person of the space, derived from this
# secret; needs ANYTYPE_CALDAV__PROPERTIES__ASSIGNEE. Keep it: every password
# changes with it.  openssl rand -hex 32
# ACCOUNTS_SECRET=
# ANYTYPE_CALDAV__PROPERTIES__ASSIGNEE=key:assignee

# Any other setting of config.example.toml, as ANYTYPE_CALDAV__<SECTION>__<KEY>:
ANYTYPE_CALDAV__CALENDAR__TIMEZONE=Europe/Saratov
ANYTYPE_CALDAV__CALENDAR__LANGUAGE=en
# ANYTYPE_CALDAV__CALDAV__EVENTS=true
